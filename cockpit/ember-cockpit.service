[Unit]
# The Cockpit's OWN Ember instance — deliberately separate from ember-dev.
#
# ember-dev binds 0.0.0.0:9092, which makes it reachable by anything on the
# tailnet. That is a SHARED surface, and the authentic skin serves art
# extracted from the machine owner's game install, which must never leave this
# machine (see docs/LOCAL_SKIN_MANIFEST.md). So the Cockpit does not flip the
# skin on ember-dev; it runs its own instance bound to loopback only.
#
# 127.0.0.1 is the load-bearing part of this file. Do not widen it.
Description=Ember — Underground Cockpit instance (loopback only, authentic skin)
After=network.target

[Service]
WorkingDirectory=/home/xsyprime/undertale-vera
Environment=UNDERTALE_VERA_SKIN=authentic
Environment=UNDERTALE_VERA_BACKEND=ollama
Environment=OLLAMA_HOST=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=llama3.1:8b
Environment=PYTHONUNBUFFERED=1
# Its own DB so cockpit play doesn't entangle with the dev instance's history.
Environment=UNDERTALE_VERA_DB=sqlite:////home/xsyprime/undertale-vera/undertale_vera_cockpit.db
ExecStart=/home/xsyprime/undertale-vera/.venv/bin/python -u -m uvicorn \
    undertale_vera_app:app --host 127.0.0.1 --port 9093
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
