# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
.venv-tts/
.pytest_cache/

# ── RAG vector index (rebuildable from knowledge/collections/*.json) ─────────
knowledge/chroma_db/
chroma.sqlite3

# ── Runtime data (read-only spine never commits uploaded saves or the DB) ────
undertale_vera.db
undertale_vera_cockpit.db
*.sqlite3
data/uploads/
saves/

# ── Generated art — NEVER batch-commit generated portraits ───────────────────
# The ComfyUI pixel-portrait pipeline writes here; sample relics are proof only.
static/assets/portraits/*.png
static/assets/portraits/*.jpg
static/assets/portraits/*.webp
# Route-reactive scene backdrops (same rule — pipeline + resolver committed, art not).
static/assets/scenes/*.png
static/assets/scenes/*.jpg
static/assets/scenes/*.webp
# Source art format — never commit raw art anywhere in the tree.
*.webp
# Overnight / batch art output (mirrors the FFT spine; ~GBs per run).
generation/
dogfood-output/

# ── Generated audio (the music LAYER is committed; the soundtrack is not) ────
*.mp3
static/audio/

# ── Inspector / QA artifacts (screenshots, summaries) ────────────────────────
dogfood-output/inspector/
preview/

# ── Logs, caches, secrets ────────────────────────────────────────────────────
logs/
*.log
.cache/
.env

# ── LoRA weights + training data (regenerable; never commit) ─────────────────
*.safetensors
models/loras/
models/tts/
dataset/
train_lora*.py

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
guided_watch.json
ember_power.json

# ── Generated emblems + packaging zips — deployed to sites, never committed ──
static/assets/emblems/
static/assets/scenes/*.zip

# ── Authentic local skin — assets extracted from the OWNER'S OWN game install ─
# tools/extract_undertale_assets.py writes here. This is a private, local-only
# skin (UNDERTALE_VERA_SKIN=authentic): game art belongs to its creators, so it
# NEVER enters the repo, a build, or a deploy. The extractor + the slot manifest
# are committed; nothing it produces ever is. Re-run the extractor per machine.
static/assets/local/

# Rendered cockpit session entry (contains an absolute path; generated by install.sh)
cockpit/.undertale-cockpit.desktop
